{
  "name": "commision_tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env.local node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=.env.local node_modules/vitest/vitest.mjs",
    "db:sync-indexes": "node --env-file=.env.local --import tsx scripts/sync-indexes.ts",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "db:clear-seed": "node --env-file=.env.local --import tsx scripts/clear-seed.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "mongoose": "^9.10.3",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "jsdom": "^27.0.1",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}